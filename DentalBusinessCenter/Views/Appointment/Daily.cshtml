@using DentalBusinessCenter.Models
@{
    ViewData["Title"] = "Daily Schedule";
    DateTime date = ViewBag.Date;
    var slots = ViewBag.Slots as List<string>;
    var apptList = ViewBag.AppointmentList as List<Appointment>;
    var doctors = ViewBag.Doctors as List<Doctor>;
    var rooms = ViewBag.Rooms as string[];
    var patients = ViewBag.Patients as List<Patient>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-calendar-day me-2 text-primary"></i>Daily Schedule</h4>
    <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Book</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Date</label>
                <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Doctor</label>
                <select name="doctorId" class="form-select form-select-sm">
                    <option value="">All Doctors</option>
                    @if (doctors != null)
                    {
                        @foreach (var d in doctors)
                        {
                            <option value="@d.Id" selected="@(ViewBag.SelectedDoctorId?.ToString() == d.Id.ToString() ? "selected" : null)">@d.FullName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Room</label>
                <select name="room" class="form-select form-select-sm">
                    <option value="">All Rooms</option>
                    @if (rooms != null)
                    {
                        @foreach (var r in rooms)
                        {
                            <option value="@r" selected="@(ViewBag.SelectedRoom == r ? "selected" : null)">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button>
                <a asp-action="Daily" class="btn btn-outline-secondary btn-sm">Today</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <span class="fw-bold">@date.ToString("dddd, MMMM dd, yyyy")</span>
        <span class="badge bg-primary ms-2">@(apptList?.Count ?? 0) appointments</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:80px;">Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Room</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th>Flags</th>
                </tr>
            </thead>
            <tbody>
                @if (slots != null)
                {
                    @foreach (var slot in slots)
                    {
                        var slotAppts = apptList?.Where(a => a.TimeSlot == slot).ToList() ?? new List<Appointment>();
                        if (slotAppts.Count == 0)
                        {
                            <tr class="table-light">
                                <td class="small text-muted fw-semibold">@slot</td>
                                <td colspan="6" class="text-muted small fst-italic">Available</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var a in slotAppts)
                            {
                                var pat = patients?.FirstOrDefault(p => p.Id == a.PatientId);
                                var doc = doctors?.FirstOrDefault(d => d.Id == a.DoctorId);
                                var badge = a.Status == "Scheduled" ? "bg-primary" : a.Status == "Completed" ? "bg-success" : "bg-secondary";
                                <tr>
                                    <td class="small fw-bold text-primary">@slot</td>
                                    <td>
                                        <div class="fw-semibold small">@(pat?.FullNameEn ?? "Unknown")</div>
                                        <div class="text-muted" style="font-size:0.7rem;">@(pat?.PrsNumber ?? "")</div>
                                    </td>
                                    <td class="small">@(doc?.FullName ?? "Unknown")</td>
                                    <td class="small">@a.Room</td>
                                    <td><span class="badge @badge">@a.Status</span></td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(a.Notes) ? "—" : a.Notes)</td>
                                    <td>
                                        @if (a.NonPaymentFlag)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

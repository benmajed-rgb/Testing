@using DentalBusinessCenter.Models
@model Patient
@{
    ViewData["Title"] = "Register New Patient";
    var doctors = ViewBag.Doctors as List<Doctor>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Register New Patient</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<p class="text-muted small mb-3"><em>Arabic / English | عربي / إنجليزي — Please fill all required fields</em></p>

<form method="post">
    <!-- Personal Info -->
    <div class="card mb-3">
        <div class="card-header bg-light fw-semibold"><i class="bi bi-person-circle me-2 text-primary"></i>Personal Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">PRS Number</label>
                    <input name="PrsNumber" class="form-control form-control-sm" value="@Model.PrsNumber" placeholder="PRS-XXX" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">QuadraMed Number</label>
                    <input name="QuadraMedNumber" class="form-control form-control-sm" value="@Model.QuadraMedNumber" placeholder="QM-XXXXX" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Full Name (English) *</label>
                    <input name="FullNameEn" class="form-control form-control-sm" value="@Model.FullNameEn" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">الاسم الكامل (عربي)</label>
                    <input name="FullNameAr" class="form-control form-control-sm" value="@Model.FullNameAr" dir="rtl" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Date of Birth *</label>
                    <input type="date" name="DateOfBirth" class="form-control form-control-sm" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Gender *</label>
                    <select name="Gender" class="form-select form-select-sm" required>
                        <option value="">Select...</option>
                        <option value="Male" selected="@(Model.Gender=="Male"?"selected":null)">Male</option>
                        <option value="Female" selected="@(Model.Gender=="Female"?"selected":null)">Female</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Nationality</label>
                    <input name="Nationality" class="form-control form-control-sm" value="@Model.Nationality" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">National ID / Iqama</label>
                    <input name="NationalId" class="form-control form-control-sm" value="@Model.NationalId" />
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Info -->
    <div class="card mb-3">
        <div class="card-header bg-light fw-semibold"><i class="bi bi-telephone me-2 text-success"></i>Contact Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Mobile *</label>
                    <input name="Mobile" class="form-control form-control-sm" value="@Model.Mobile" placeholder="05XXXXXXXX" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Email</label>
                    <input type="email" name="Email" class="form-control form-control-sm" value="@Model.Email" />
                </div>
            </div>
        </div>
    </div>

    <!-- Medical Category -->
    <div class="card mb-3">
        <div class="card-header bg-light fw-semibold"><i class="bi bi-clipboard2-pulse me-2 text-danger"></i>Medical Category & Assignment</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Patient Category *</label>
                    <select name="Category" class="form-select form-select-sm" required>
                        <option value="">Select...</option>
                        @foreach (var cat in new[] { "Regular", "VIP", "Pedo", "OR", "Hygienist" })
                        {
                            <option value="@cat" selected="@(Model.Category==cat?"selected":null)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Assigned Doctor</label>
                    <select name="AssignedDoctorIds" class="form-select form-select-sm">
                        <option value="">Unassigned</option>
                        @if (doctors != null)
                        {
                            @foreach (var d in doctors)
                            {
                                <option value="@d.Id">@d.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="HasNonPayment" value="true" id="npFlag" @(Model.HasNonPayment ? "checked" : "") />
                        <label class="form-check-label small fw-semibold text-warning" for="npFlag">
                            <i class="bi bi-exclamation-triangle me-1"></i>Non-Payment Flag
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Register Patient</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

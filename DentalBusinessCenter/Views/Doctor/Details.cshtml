@using DentalBusinessCenter.Models
@model Doctor
@{
    ViewData["Title"] = "Doctor: " + Model.FullName;
    var patients = ViewBag.Patients as List<Patient>;
    var visits = ViewBag.Visits as List<PatientVisit>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Doctor Profile</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width:64px;height:64px;font-size:1.5rem;">
                @Model.FullName.Split(' ').Skip(1).FirstOrDefault()?.Substring(0,1).ToUpper()
            </div>
            <div class="flex-grow-1">
                <h5 class="mb-0 fw-bold">@Model.FullName</h5>
                <div class="text-muted">@Model.Specialty</div>
                <div class="d-flex gap-2 mt-1">
                    <span class="badge bg-primary">@Model.ClinicType</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-door-open me-1"></i>@Model.AssignedRoom</span>
                </div>
            </div>
            <div class="text-end">
                <div class="small text-muted">Total Appointments</div>
                <div class="fw-bold fs-4 text-primary">@ViewBag.AppointmentCount</div>
                <div class="small text-muted mt-2">Assigned Patients</div>
                <div class="fw-bold fs-4 text-success">@(patients?.Count ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Assigned Patients</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>PRS#</th><th>Name</th><th>Category</th><th>Mobile</th><th>Last Visit</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (patients != null && patients.Count > 0)
                {
                    @foreach (var p in patients)
                    {
                        var catBadge = p.Category switch {
                            "VIP" => "bg-warning text-dark",
                            "OR" => "bg-danger",
                            "Pedo" => "bg-info text-dark",
                            "Hygienist" => "bg-success",
                            _ => "bg-secondary"
                        };
                        var lastVisit = visits?.Where(v => v.PatientId == p.Id).OrderByDescending(v => v.VisitDate).FirstOrDefault();
                        <tr>
                            <td class="small fw-semibold text-primary">@p.PrsNumber</td>
                            <td class="small fw-semibold">@p.FullNameEn</td>
                            <td><span class="badge @catBadge">@p.Category</span></td>
                            <td class="small">@p.Mobile</td>
                            <td class="small">@(lastVisit?.VisitDate.ToString("dd MMM yyyy") ?? "No visits")</td>
                            <td>
                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-0 px-2"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No patients assigned</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using DentalBusinessCenter.Models
@model List<Appointment>
@{
    ViewData["Title"] = "Non-Payment Alerts";
    var patients = ViewBag.Patients as List<Patient>;
    var doctors = ViewBag.Doctors as List<Doctor>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Non-Payment Alerts</h4>
    <span class="badge bg-warning text-dark fs-6">@Model.Count flagged records</span>
</div>

<div class="alert alert-warning d-flex align-items-center gap-2 py-2">
    <i class="bi bi-info-circle"></i>
    <small>The following appointments have non-payment flags. Please review before proceeding.</small>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Room</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    @foreach (var a in Model)
                    {
                        var pat = patients?.FirstOrDefault(p => p.Id == a.PatientId);
                        var doc = doctors?.FirstOrDefault(d => d.Id == a.DoctorId);
                        var badge = a.Status == "Scheduled" ? "bg-primary" : a.Status == "Completed" ? "bg-success" : "bg-secondary";
                        <tr>
                            <td class="small">@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td class="small">@a.TimeSlot</td>
                            <td>
                                <div class="fw-semibold small">@(pat?.FullNameEn ?? "Unknown")</div>
                                <div class="text-muted" style="font-size:0.7rem;">@(pat?.PrsNumber ?? "") | @(pat?.Mobile ?? "")</div>
                            </td>
                            <td class="small">@(doc?.FullName ?? "Unknown")</td>
                            <td class="small">@a.Room</td>
                            <td><span class="badge @badge">@a.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-check-circle text-success me-2"></i>No non-payment flags</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

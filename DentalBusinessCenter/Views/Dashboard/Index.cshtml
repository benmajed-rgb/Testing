@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h4>
    <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg,#1a78c2,#0d4f8c);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@ViewBag.TodayAppointments</div>
                    <div class="stat-label">Today's Appointments</div>
                </div>
                <i class="bi bi-calendar-check stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg,#198754,#0d5c38);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@ViewBag.ActivePatients</div>
                    <div class="stat-label">Active Patients</div>
                </div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg,#fd7e14,#b85c00);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@ViewBag.Alerts</div>
                    <div class="stat-label">Non-Payment Alerts</div>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg,#0dcaf0,#0a7a96);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@ViewBag.DoctorCount</div>
                    <div class="stat-label">Total Doctors</div>
                </div>
                <i class="bi bi-person-badge stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Weekly Chart -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white border-bottom-0 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Weekly Appointments (Top 5 Doctors)</h6>
            </div>
            <div class="card-body">
                <canvas id="weeklyChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <!-- Quick Actions -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white border-bottom-0 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-lightning me-2 text-warning"></i>Quick Actions</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2 justify-content-center">
                <a asp-controller="Patient" asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus me-2"></i>Register New Patient
                </a>
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-success btn-lg">
                    <i class="bi bi-calendar-plus me-2"></i>Book Appointment
                </a>
                <a asp-controller="Appointment" asp-action="Daily" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-calendar-day me-2"></i>Today's Schedule
                </a>
                <a asp-controller="Appointment" asp-action="NonPayment" class="btn btn-outline-warning btn-lg">
                    <i class="bi bi-exclamation-triangle me-2"></i>Non-Payment Alerts
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Appointments -->
<div class="card">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-secondary"></i>Recent Appointments</h6>
        <a asp-controller="Appointment" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Room</th>
                        <th>Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.RecentAppointments)
                    {
                        <tr>
                            <td class="small">@item.Appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td class="small fw-semibold">@(item.Patient?.FullNameEn ?? "Unknown")</td>
                            <td class="small">@(item.Doctor?.FullName ?? "Unknown")</td>
                            <td class="small">@item.Appointment.Room</td>
                            <td class="small">@item.Appointment.TimeSlot</td>
                            <td>
                                @{
                                    var sc = item.Appointment.Status;
                                    var badge = sc == "Scheduled" ? "bg-primary" : sc == "Completed" ? "bg-success" : "bg-secondary";
                                }
                                <span class="badge @badge">@sc</span>
                                @if (item.Appointment.NonPaymentFlag)
                                {
                                    <span class="badge bg-warning text-dark ms-1"><i class="bi bi-exclamation-triangle"></i></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const ctx = document.getElementById('weeklyChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(ViewBag.ChartLabels),
            datasets: [{
                label: 'Appointments This Week',
                data: @Html.Raw(ViewBag.ChartData),
                backgroundColor: ['#1a78c2','#198754','#fd7e14','#0dcaf0','#6f42c1'],
                borderRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}

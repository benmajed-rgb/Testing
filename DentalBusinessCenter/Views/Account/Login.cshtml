@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Dental Business Center</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d1b2a 0%, #1a3a5c 60%, #1a78c2 100%);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
        }
        .login-card {
            width: 100%; max-width: 420px;
            background: #fff; border-radius: 1rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #0d1b2a, #1a78c2);
            padding: 2rem; text-align: center; color: #fff;
        }
        .login-header i { font-size: 3rem; color: #5bc8f5; }
        .login-header h2 { font-size: 1.3rem; font-weight: 700; margin: 0.5rem 0 0.2rem; }
        .login-header p { font-size: 0.8rem; color: #aad4f5; margin: 0; }
        .login-body { padding: 2rem; }
        .form-control:focus { border-color: #1a78c2; box-shadow: 0 0 0 0.2rem rgba(26,120,194,0.25); }
        .btn-signin { background: #1a78c2; border-color: #1a78c2; font-weight: 600; letter-spacing: 0.05em; }
        .btn-signin:hover { background: #1565a8; border-color: #1565a8; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="login-header">
        <i class="bi bi-hospital"></i>
        <h2>Dental Business Center</h2>
        <p>Patient Management System</p>
    </div>
    <div class="login-body">
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
        }
        <form method="post" action="/Account/Login">
            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">USERNAME</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Enter username" required autofocus />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold small text-muted">PASSWORD</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Enter password" required />
                </div>
            </div>
            <button type="submit" class="btn btn-signin btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>SIGN IN
            </button>
        </form>
        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            <i class="bi bi-question-circle me-1"></i>Forgot password? Contact IT Support
        </p>
        <div class="mt-3 p-2 bg-light rounded small text-muted">
            <strong>Demo Credentials:</strong><br/>
            Admin: admin / admin123<br/>
            Doctor: doctor1 / doc123<br/>
            Reception: reception1 / rec123
        </div>
    </div>
</div>
</body>
</html>
